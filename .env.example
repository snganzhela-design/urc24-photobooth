# ---- ИИ (шлюз ProxyAPI: рубли, без VPN) ----
AI_BASE_URL=https://api.proxyapi.ru
AI_API_KEY=
# Порядок моделей: первая — основная. gemini-2.5-flash-image ≈10 ₽/кадр, gemini-3.1-flash-image ≈25 ₽/кадр
AI_MODELS=gemini-2.5-flash-image,gemini-3.1-flash-image
# Запасной провайдер OpenAI-формата на том же ключе (пусто — выключен)
AI_FALLBACK=openai/gpt-image-1-mini
AI_OPENAI_BASE=https://api.proxyapi.ru/v1
AI_TIMEOUT_MS=45000
AI_BUDGET_MS=100000

# ---- Загрузка готовых кадров для QR ----
PUBLIC_BASE=https://api.unigeniq.com
# UPLOAD_URL по умолчанию = PUBLIC_BASE/api/urc24/photo-booth
UPLOAD_TOKEN=

# ---- Киоск ----
PORT=3777
# Нумерация «пилотов» P001…: с какого номера начать
START_NUMBER=1
# gray — как карточки пилотов на лендинге; color — цветной кадр
STYLE=gray
